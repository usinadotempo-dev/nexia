{
  "name": "nexia",
  "version": "0.2.0",
  "private": true,
  "description": "NexIA — IA com proteção de dados para profissionais de qualquer área: anonimização local, receitas por área, consultas a APIs públicas, OCR local e conector PJe.",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
