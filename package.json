    "icones": "node scripts/gerar-icones.js",
    "pacote": "vite build && node scripts/empacotar.js"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.31",
    "@types/chrome": "^0.0.323",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-static-copy": "^2.1.0"
  },
  "dependencies": {
    "onnxruntime-web": "^1.20.1",
    "pdfjs-dist": "^4.0.0",
    "ppu-paddle-ocr": "^5.8.3"
  }
}
