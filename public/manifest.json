{
  "manifest_version": 3,
  "name": "Nexpra",
  "version": "0.3.0",
  "description": "IA com proteção de dados para profissionais: anonimização local, funcionalidades por área, fontes públicas e conectores jurídicos.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "public/icons/nexia-16.png",
    "32": "public/icons/nexia-32.png",
    "48": "public/icons/nexia-48.png",
    "128": "public/icons/nexia-128.png"
  },
  "action": {
    "default_title": "Abrir o Nexpra",
    "default_icon": {
      "16": "public/icons/nexia-16.png",
      "32": "public/icons/nexia-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "permissions": ["storage", "offscreen", "sidePanel", "contextMenus", "scripting", "activeTab"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; object-src 'self'"
  },
  "host_permissions": [
    "https://*.jus.br/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://brasilapi.com.br/*",
    "https://viacep.com.br/*",
    "https://api.bcb.gov.br/*",
    "https://olinda.bcb.gov.br/*",
    "https://servicodados.ibge.gov.br/*",
    "https://api.portaldatransparencia.gov.br/*",
    "https://dadosabertos.camara.leg.br/*",
    "https://eutils.ncbi.nlm.nih.gov/*",
    "https://api.fda.gov/*",
    "https://clinicaltables.nlm.nih.gov/*",
    "https://api.crossref.org/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://archive-api.open-meteo.com/*",
    "https://legis.senado.leg.br/*",
    "https://normas.leg.br/*",
    "https://certidoes-apf.apps.tcu.gov.br/*",
    "https://pncp.gov.br/*",
    "https://api.queridodiario.org.br/*",
    "https://consumo.tributos.gov.br/*",
    "https://parallelum.com.br/*",
    "https://www.ebi.ac.uk/*",
    "https://clinicaltrials.gov/*",
    "https://info.dengue.mat.br/*",
    "https://api.bncc.dev/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": ["https://*.jus.br/*"],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://*.jus.br/*"],
      "js": ["src/main/captura-auth.ts"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["https://*.jus.br/*"],
      "js": ["src/main/ponte-fetch.ts"],
      "run_at": "document_idle",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["libs/*", "assets/*"],
      "matches": ["https://*.jus.br/*"]
    }
  ]
}
