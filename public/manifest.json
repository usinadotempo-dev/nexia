{
  "manifest_version": 3,
  "name": "NexIA",
  "version": "0.1.0",
  "description": "Assistente inteligente para sistemas processuais (PJe): chat com anonimização local, resumos e minutas.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/nexia-16.png",
    "32": "icons/nexia-32.png",
    "48": "icons/nexia-48.png",
    "128": "icons/nexia-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/nexia-16.png",
      "32": "icons/nexia-32.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "activeTab"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "host_permissions": [
    "https://*.jus.br/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.jus.br/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://*.jus.br/*"],
      "js": ["main-auth.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["https://*.jus.br/*"],
      "js": ["main-bridge.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["libs/*"],
      "matches": ["https://*.jus.br/*"]
    }
  ]
}
